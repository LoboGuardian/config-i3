# Volume up (usually F9)
bindsym $mod+Shift+F10 exec "pamixer -ui 3 && pamixer --get-volume > /tmp/xobpipe"
# Volume down (usually F8)
bindsym $mod+Shift+F9 exec "pamixer -ud 3 && pamixer --get-volume > /tmp/xobpipe"
# Mute sound (usually F10)
bindsym $mod+Shift+F8 exec "amixer sset Master toggle | sed -En '/\[on\]/ s/.*\[([0-9]+)%\].*/\1/ p; /\[off\]/ s/.*/0/p' | head -1 > /tmp/xobpipe"

# Launch applications
bindsym $mod+Shift+p exec gnome-calculator
#bindsym $mod+p exec ~/.scripts/dmshot

## This will switch the current layout to the 'us'.
#bindsym $mod+l exec "setxkbmap -layout us && sleep 0.1 && setxkbmap -option grp:caps_toggle 'us,ru' -option grp_led:caps && sleep 0.1 && i3lock --blur 5"

## This keybind will lock the screen. The lockscreen.
bindsym $mod+l exec "sleep 0.1 && i3lock --blur 5"

bindsym $mod+b exec cachy-browser
bindsym $mod+c exec zeditor

# Power menu
bindsym $mod+Escape exec "i3-nagbar -t warning -m 'What do you want to do?' -b 'Log off' 'i3-msg exit' -b 'Reboot' 'systemctl reboot' -b 'Shut down' 'systemctl poweroff'"

